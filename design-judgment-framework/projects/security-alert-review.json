                    },
                    {
                      "title": "Evidence and safe actions",
                      "detail": "Review / Escalate / Dismiss with audit trail"
                    }
                  ],
                  "action": "Escalate with rationale",
                  "rationale": "Retains queue efficiency while supporting reversible, auditable context pivots."
                }
              ]
            },
            {
              "type": "table",
              "title": "Explicit trade-offs",
              "columns": [
                "Gain",
                "Cost",
                "Mitigation"
              ],
              "rows": [
                [
                  "Fast queue entry",
                  "Less obvious resource-wide view",
                  "Prominent asset pivot and saved views"
                ],
                [
                  "Dense operational context",
                  "Learning curve for unfamiliar users",
                  "Progressive explanation and clear labels"
                ],
                [
                  "Manual analyst control",
                  "More interaction choices",
                  "Use safe defaults and task-based tests"
                ]
              ]
            },
            {
              "type": "callout",
              "heading": "Decision threshold",
              "text": "If real investigation tests show repeated context loss or materially worse accuracy than resource-/incident-first designs, revisit the structural decision rather than only polishing visuals.",
